# URL of the API when the frontend is hosted elsewhere (Cloudflare Pages → Render), without
# a trailing slash, e.g. https://techmatch-api.onrender.com. Empty: same origin (development
# uses the Vite proxy). Read at build time (docs/16-DESPLIEGUE.md).
VITE_API_URL=
# Max CV size shown and checked in the browser (the API enforces CV_MAX_SIZE_BYTES).
VITE_CV_MAX_SIZE_MB=5
