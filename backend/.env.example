NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origins allowed to call the API from a browser, comma-separated. In production, the
# Cloudflare Pages URL of the frontend (docs/16-DESPLIEGUE.md).
CORS_ORIGIN=http://localhost:5173
# Behind a hosting proxy (Render): true, so the upload limit sees the client IP.
TRUST_PROXY=false
# Optional: serve the built frontend from the API too (single-service deploy).
FRONTEND_DIST_DIR=

DATABASE_URL=postgres://techmatch:techmatch@localhost:5434/techmatch
TEST_DATABASE_URL=postgres://techmatch:techmatch@localhost:5434/techmatch_test

# CV upload
CV_MAX_SIZE_BYTES=5242880
CV_STORAGE_DIR=./storage/cvs
CV_MIN_TEXT_CHARS=50
# Public trends dashboard: cache (minutes) and list sizes
STATS_CACHE_MINUTES=60
STATS_TOP_SKILLS=15
STATS_TOP_COMPANIES=10

# Recommendations visible without an account (the rest are an account privilege)
ANONYMOUS_RECOMMENDATIONS_LIMIT=3

# Accounts (docs/17-CUENTAS-DE-USUARIO.md): session length and register/login attempts per IP
SESSION_TTL_DAYS=30
AUTH_LIMIT_MAX=10
AUTH_LIMIT_WINDOW_MINUTES=15

# Email (docs/17-CUENTAS-DE-USUARIO.md): smtp = Mailpit in development (npm run db:up starts it;
# emails at http://localhost:8025), brevo = Brevo's HTTP API in production.
# Check the setup with: npm run send-test-email -w backend -- you@example.com
EMAIL_PROVIDER=smtp
# Base of the links in the emails (the web app); empty = the first CORS_ORIGIN
FRONTEND_URL=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_FROM=no-reply@techmatch.local
EMAIL_FROM_NAME=TechMatch
SMTP_HOST=localhost
SMTP_PORT=1025
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=

# Days a CV is kept; older ones are deleted by: npm run purge-cvs
CV_RETENTION_DAYS=30
# Uploads allowed per IP in each window (429 RATE_LIMITED after that)
CV_UPLOAD_LIMIT_MAX=10
CV_UPLOAD_LIMIT_WINDOW_MINUTES=15

# Optional JSON file overriding matching weights/thresholds (see src/matching/matching-config.ts)
MATCHING_CONFIG_PATH=

# Job offers sync from source APIs (docs/05-FUENTES-DE-OFERTAS.md).
# Runs inside the API when enabled, or standalone: npm run sync-jobs [-- --schedule]
JOB_SYNC_ENABLED=false
JOB_SYNC_RUN_ON_START=false
JOB_SYNC_INTERVAL_HOURS=12
JOB_SYNC_MAX_OFFERS_PER_SOURCE=300
HTTP_USER_AGENT=TechMatchBot/0.1
HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=2
HTTP_REQUEST_DELAY_MS=1000
HTTP_BACKOFF_BASE_MS=2000

GETONBOARD_ENABLED=true
GETONBOARD_API_URL=https://www.getonbrd.com/api/v0
GETONBOARD_CATEGORIES=programming,data-science-analytics,sysadmin-devops-qa,mobile-developer,machine-learning-ai,cybersecurity
GETONBOARD_PER_PAGE=50

# Company job boards: "slug:Nombre" separated by commas (only tech roles, remote or in Argentina)
LEVER_ENABLED=true
LEVER_API_URL=https://api.lever.co/v0
LEVER_COMPANIES=despegar:Despegar,kavak:Kavak
GREENHOUSE_ENABLED=true
GREENHOUSE_API_URL=https://boards-api.greenhouse.io/v1
GREENHOUSE_COMPANIES=clara:Clara
